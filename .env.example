# ══════════════════════════════════════════════════════════════════════════════
# SQL RAG System — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Pinecone (Vector DB) ─────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=dvd-rental-schema

# ── Google Gemini (LLM) ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Neo4j (Graph DB for Join Path Discovery) ─────────────────────────────────
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=your_neo4j_database
AURA_INSTANCEID=your_aura_instance_id
AURA_INSTANCENAME=Instance01

# ── HuggingFace (Embedding via Inference API) ────────────────────────────────
HF_API_TOKEN=your_huggingface_api_token_here

# ── Microsoft SQL Server (original source DB — used by data pipeline only) ───
MSSQL_CONNECTION_STRING=mssql+pymssql://user:password@your-server.database.windows.net/AdventureWorks

# ── Supabase / PostgreSQL (runtime query execution) ──────────────────────────
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Note: Special characters in password must be URL-encoded (e.g., '@' → '%40')
SUPABASE_CONNECTION_STRING=postgresql+psycopg2://postgres:your_password@db.your-project.supabase.co:6543/postgres
TARGET_SCHEMAS=public

# ── MongoDB (Conversation Memory) ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=YourApp
MONGODB_DB_NAME=rag_system

# ── Frontend (optional — set in Vercel dashboard for production) ─────────────
# FRONTEND_URL=https://your-app.vercel.app
